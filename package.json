{
  "name": "extended-yaml-support",
  "displayName": "Extended YAML Support",
  "description": "Embedded language highlighting and visual boundaries for tagged YAML block scalars.",
  "version": "0.1.0",
  "publisher": "CenterForAgenticAI",
  "license": "MIT",
  "author": {
    "name": "Center for Agentic AI"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "yaml",
    "embedded languages",
    "syntax highlighting",
    "markdown",
    "python",
    "typescript",
    "prompt engineering"
  ],
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#172554",
    "theme": "dark"
  },
  "pricing": "Free",
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onLanguage:yaml"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CenterForAgenticAI/extended-yaml-support.git"
  },
  "homepage": "https://github.com/CenterForAgenticAI/extended-yaml-support#readme",
  "bugs": {
    "url": "https://github.com/CenterForAgenticAI/extended-yaml-support/issues"
  },
  "qna": "https://github.com/CenterForAgenticAI/extended-yaml-support/discussions",
  "files": [
    "dist/**",
    "syntaxes/**",
    "images/icon.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SUPPORT.md"
  ],
  "contributes": {
    "grammars": [
      {
        "scopeName": "source.yaml.extended.injection",
        "path": "./syntaxes/extended-yaml-injection.json",
        "injectTo": [
          "source.yaml",
          "source.yaml.1.0",
          "source.yaml.1.1",
          "source.yaml.1.2",
          "source.yaml.1.3",
          "text.yaml",
          "text.yaml.jinja"
        ],
        "embeddedLanguages": {
          "meta.embedded.inline.markdown": "markdown",
          "meta.embedded.inline.python": "python",
          "meta.embedded.inline.json": "json",
          "meta.embedded.inline.typescript": "typescript",
          "meta.embedded.inline.rust": "rust",
          "meta.embedded.inline.shell": "shellscript",
          "meta.embedded.inline.ruby": "ruby",
          "meta.embedded.inline.diff": "diff",
          "meta.embedded.inline.toml": "toml"
        }
      }
    ],
    "configuration": {
      "title": "Extended YAML Support",
      "properties": {
        "extendedYaml.decorations.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show visual backgrounds and XML-style tag colors in supported YAML blocks."
        },
        "extendedYaml.decorations.codeBlockBackground": {
          "type": "string",
          "default": "rgba(0, 0, 0, 0.15)",
          "description": "Background color for embedded code."
        },
        "extendedYaml.decorations.markdownBlockBackground": {
          "type": "string",
          "default": "rgba(30, 60, 90, 0.15)",
          "description": "Background color for embedded Markdown."
        },
        "extendedYaml.decorations.xmlTagColor": {
          "type": "string",
          "default": "#e06c75",
          "description": "Foreground color for XML-style tags in embedded Markdown."
        },
        "extendedYaml.decorations.xmlContentBackground": {
          "type": "string",
          "default": "rgba(224, 108, 117, 0.08)",
          "description": "Background color for content enclosed by XML-style tags."
        },
        "extendedYaml.decorations.debounceMilliseconds": {
          "type": "number",
          "default": 75,
          "minimum": 0,
          "maximum": 1000,
          "description": "Delay before decorations are recalculated after an edit."
        }
      }
    }
  },
  "scripts": {
    "clean": "rimraf dist artifacts coverage",
    "generate:grammar": "tsx scripts/generate-grammar.ts",
    "build": "rimraf dist && npm run generate:grammar && esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node18 --external:vscode --outfile=dist/extension.cjs --sourcemap",
    "build:test": "esbuild test/integration/index.ts --bundle --platform=node --format=cjs --target=node18 --external:vscode --outfile=dist/test/integration.cjs --sourcemap",
    "watch": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node18 --external:vscode --outfile=dist/extension.cjs --sourcemap --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:extension": "npm run build && npm run build:test && tsx scripts/run-extension-test.ts",
    "test:package": "npm run build:test && tsx scripts/run-extension-test.ts artifacts/extended-yaml-support.vsix",
    "vscode:prepublish": "npm run build",
    "package": "rimraf artifacts && node -e \"require('node:fs').mkdirSync('artifacts', { recursive: true })\" && vsce package --no-dependencies --out artifacts/extended-yaml-support.vsix",
    "package:verify": "tsx scripts/verify-package.ts artifacts/extended-yaml-support.vsix",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run package && npm run package:verify"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "@types/vscode": "1.85.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "fflate": "^0.8.3",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.10",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
